{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "preview-apk": {
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk" // Esto fuerza la salida de un archivo .apk
      }
    }
  },
  "submit": {
    "production": {}
  }
}